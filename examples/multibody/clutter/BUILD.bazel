load("@drake//tools/skylark:drake_cc.bzl", "drake_cc_binary")
load("//tools/lint:lint.bzl", "add_lint_tests")

drake_cc_binary(
    name = "clutter",
    srcs = ["clutter.cc"],
    data = ["config.yaml"],
    deps = [
        "//common:add_text_logging_gflags",
        "//common/yaml",
        "//geometry:meshcat_visualizer",
        "//multibody/cenic:cenic_integrator",
        "//multibody/contact_solvers/sap:sap_solver",
        "//multibody/parsing:package_map",
        "//multibody/plant",
        "//multibody/tree:geometry_spatial_inertia",
