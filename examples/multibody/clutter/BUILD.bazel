        "//systems/analysis:simulator_config_functions",
        "//systems/analysis:simulator_print_stats",
        "//systems/framework:diagram",
        "//visualization:visualization_config_functions",
        "@gflags",
    ],
    add_test_rule = True,
)

drake_cc_binary(
    name = "mesh_preflight",
    srcs = ["mesh_preflight.cc"],
    deps = [
        "//common:unused",
        "//geometry:shape_specification",
        "//geometry/proximity:inflate_mesh",
        "//geometry/proximity:mesh_field",
        "//geometry/proximity:obj_to_surface_mesh",
        "//multibody/tree:geometry_spatial_inertia",
        "@fmt",
        "@gflags",
    ],
)

add_lint_tests()
