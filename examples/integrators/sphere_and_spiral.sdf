<?xml version="1.0"?>
<sdf version="1.7" xmlns:drake="http://drake.mit.edu">
  <model name="sphere_and_spiral">

    <!-- The spiral is fixed to the world -->
    <link name="spiral">
      <pose>0 0 1.5 0 0 0</pose>
      <visual name="spiral_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>package://drake/examples/integrators/spiral_fine.obj</uri>
            <scale>1.0 1.0 1.0</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.2 0.6 1.0 0.4</diffuse>
        </material>
      </visual>
      <collision name="spiral_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>package://drake/examples/integrators/spiral_fine.obj</uri>
            <scale>1.0 1.0 1.0</scale>
          </mesh>
        </geometry>
      </collision>
    </link>
    <joint name="spiral_joint" type="fixed">
      <parent>world</parent>
      <child>spiral</child>
    </joint>

    <!-- A thin box as the ground plane -->
    <link name="ground">
      <pose>0 0 0 0 0 0</pose>
      <visual name="ground_visual">
        <geometry>
          <box>
            <size>10 10 0.01</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.8 0.75 0.6 1.0</diffuse>
        </material>
      </visual>
      <collision name="ground_collision">
        <geometry>
          <box>
            <size>10 10 0.01</size>
          </box>
        </geometry>
      </collision>
    </link>
    <joint name="ground_joint" type="fixed">
      <parent>world</parent>
      <child>ground</child>
    </joint>

    <!-- The free-floating sphere -->
    <link name="sphere">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>3.5522e-4</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>3.5522e-4</iyy>
          <iyz>0</iyz>
          <izz>3.5522e-4</izz>
        </inertia>
      </inertial>
      <visual name="sphere_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.0295</radius>
          </sphere>
        </geometry>
        <material>
          <diffuse>1.0 0.3 0.2 1.0</diffuse>
        </material>
      </visual>
      <collision name="sphere_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.0295</radius>
          </sphere>
        </geometry>
      </collision>
    </link>

  </model>
</sdf>
