<?xml version='1.0'?>
<sdf xmlns:drake="http://drake.mit.edu" version="1.8">
  <model name='nut_and_bolt'>
    <link name='bolt'>
      <inertial>
        <pose>1.6967167559043916e-05 -2.8589258913969606e-06 0.017329423246084944 0 0 0</pose>
        <mass>0.07340903191896793</mass>
        <inertia>
          <ixx>1.1568853109599252e-05</ixx>
          <ixy>3.870582615599469e-10</ixy>
          <ixz>-4.4046647054479945e-09</ixz>
